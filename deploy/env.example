# /etc/trainer.env — environment for trainer.service
PORT=3000
HOST=0.0.0.0
DATA_DIR=/var/lib/trainer
# Optional: protects the app with one password (leave empty on a trusted LAN)
APP_PASSWORD=
# Optional: stable secret for the login cookie (random when empty; users re-login after restart)
APP_SECRET=
# Coach backend, pick one:
#  a) Claude subscription: run `claude setup-token` on a logged-in machine and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=
#  b) API key
ANTHROPIC_API_KEY=
# Models for the CLI backend (aliases or full ids)
COACH_MODEL_FOOD=sonnet
COACH_MODEL_REVIEW=opus
COACH_MODEL_CHAT=sonnet
DISABLE_AUTOUPDATER=1
# Optional: speak rest-timer cues on a Home Assistant media player (needs a TTS integration in HA)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_TTS_ENTITY=tts.google_translate_en_com
HA_MEDIA_PLAYER=media_player.living_room
# Optional: push coach replies, the weekly review and the daily reminder to your phone.
#  a) Home Assistant Companion app: the notify service of your phone (uses HA_URL and HA_TOKEN above)
HA_NOTIFY_SERVICE=
#  b) or an ntfy topic, e.g. https://ntfy.sh/some-long-random-topic (token only for protected topics)
NTFY_URL=
NTFY_TOKEN=
# Where tapping a notification goes: restbell:// opens the iOS app; use your https address to open the PWA instead
NOTIFY_LINK_BASE=restbell://
