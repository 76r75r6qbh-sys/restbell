[Unit]
Description=Trainer — personal training tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trainer
Group=trainer
WorkingDirectory=/opt/trainer
EnvironmentFile=/etc/trainer.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trainer
PrivateTmp=true

[Install]
WantedBy=multi-user.target
