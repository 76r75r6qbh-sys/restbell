// Shared build settings. Put your own team and bundle prefix in Local.xcconfig (copy Local.example.xcconfig);
// free Apple accounts need a bundle prefix nobody else has registered.
BUNDLE_ID_PREFIX = com.example
RESTBELL_TEAM =

#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(RESTBELL_TEAM)
APP_GROUP = group.$(BUNDLE_ID_PREFIX).restbell
